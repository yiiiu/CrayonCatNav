// 蜡笔猫导航数据模型：见 docs/蜡笔猫导航-v1-架构.md §3

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ResourceStatus {
  draft
  published
  archived
}

enum PricingType {
  unknown
  free
  freemium
  paid
}

enum ToolStatus {
  enabled
  hidden
  beta
}

enum AdminRole {
  owner
  editor
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0)
  resources Resource[]
  /// 采集配置单独成表：公共分类查询（include 全字段）不会带出内部配置
  collectConfig CategoryCollectConfig?
  collectRuns   CollectRun[]
}

model Tag {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  resources ResourceTag[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Tag_name_trgm_idx")
}

model Resource {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  summary       String
  description   String         @default("")
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  websiteUrl    String?
  githubUrl     String?
  iconUrl       String?
  pricingType   PricingType    @default(unknown)
  status        ResourceStatus @default(draft)
  featuredOrder Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tags          ResourceTag[]
  tools         ResourceTool[]
  metrics       DailyMetric[]
  candidates    ResourceCandidate[]

  @@index([status, categoryId])
  @@index([featuredOrder])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Resource_name_trgm_idx")
  @@index([summary(ops: raw("gin_trgm_ops"))], type: Gin, map: "Resource_summary_trgm_idx")
}

model ResourceTag {
  resourceId String
  tagId      String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
  @@index([tagId])
}

/// 工具能力以代码注册表（lib/tools/registry.ts）为准；本表只存运营状态与排序
model Tool {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String
  status      ToolStatus     @default(enabled)
  sortOrder   Int            @default(0)
  resources   ResourceTool[]
  metrics     DailyMetric[]
}

model ResourceTool {
  resourceId   String
  toolId       String
  relationType String   @default("related")
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tool         Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([resourceId, toolId])
  @@index([toolId])
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(editor)
  createdAt    DateTime  @default(now())
}

/// 匿名按日聚合计数，不记录原始输入
model DailyMetric {
  id         String    @id @default(cuid())
  date       DateTime  @db.Date
  eventType  String
  resourceId String?
  toolId     String?
  count      Int       @default(0)
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  tool       Tool?     @relation(fields: [toolId], references: [id], onDelete: SetNull)

  @@unique([date, eventType, resourceId, toolId])
  @@index([eventType, date])
}

/// 自建访问统计：页面浏览按日聚合（无 Cookie、匿名）。日期按 Asia/Shanghai 自然日。
/// source：direct / internal / google / bing / other_search / social / referral；
/// refDomain 只存来源域名（不存完整 URL），direct / internal / google / bing 为空串。
model PageViewDaily {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  path      String   @db.VarChar(160)
  source    String   @db.VarChar(16)
  refDomain String   @default("") @db.VarChar(253)
  device    String   @db.VarChar(8)
  views     Int      @default(0)

  @@unique([date, path, source, refDomain, device])
  @@index([date])
}

/// 当日独立访客：hash = sha256(当日随机盐 + IP + UA) 截断，不存 IP/UA 原文；盐每日轮换并删除，无法跨天关联。
model DailyVisitor {
  date DateTime @db.Date
  hash String   @db.VarChar(32)

  @@id([date, hash])
}

/// 访客哈希用的当日随机盐；只保留当天一条，过期即删。
model AnalyticsSalt {
  date DateTime @id @db.Date
  salt String   @db.VarChar(64)
}

/* ---------- 后台采集 Agent + 候选箱（2026-10-26，见架构 §9「采集 Agent」） ---------- */

enum CandidateStatus {
  pending
  published
  drafted
  rejected
}

enum CollectRunStatus {
  running
  succeeded
  failed
}

/// 采集 Agent 设置（单例，id 固定为 "singleton"）。密钥类字段为 AES-256-GCM 密文，另存末四位用于展示。
model AgentSetting {
  id               String    @id @default("singleton")
  baseUrl          String    @default("")
  model            String    @default("")
  apiKeyEnc        String?
  apiKeyLast4      String?   @db.VarChar(4)
  maxPerRun        Int       @default(8)
  srcMcpRegistry   Boolean   @default(true)
  srcGithub        Boolean   @default(true)
  srcAwesome       Boolean   @default(true)
  srcHuggingface   Boolean   @default(true)
  srcProductHunt   Boolean   @default(false)
  githubTokenEnc   String?
  githubTokenLast4 String?   @db.VarChar(4)
  phTokenEnc       String?
  phTokenLast4     String?   @db.VarChar(4)
  /// 运行锁：非空且晚于当前时间表示有采集在跑；过期视为上次运行被中断
  lockedUntil      DateTime?
  updatedAt        DateTime  @updatedAt
}

/// 一次采集运行的记录
model CollectRun {
  id               String            @id @default(cuid())
  trigger          String            @db.VarChar(16)
  status           CollectRunStatus  @default(running)
  startedAt        DateTime          @default(now())
  finishedAt       DateTime?
  found            Int               @default(0)
  created          Int               @default(0)
  skipped          Int               @default(0)
  failed           Int               @default(0)
  error            String?
  /// 各来源拉取情况与非致命问题（如某来源超时），不含任何密钥
  notes            Json?
  promptTokens     Int?
  completionTokens Int?
  /// 本次的目标分类（按分类定向采集；贴链接整理为空）。分类删除后置空
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  candidates       ResourceCandidate[]

  @@index([startedAt])
  @@index([categoryId])
}

/// 分类的采集配置（2026-10-26，见架构 §9「按分类定向采集」）：一分类一行；没有行 = 未配置，不参与自动采集。
/// config 结构见 lib/validation/collect-config.ts（zod 校验后写入，读取时再次校验）。
model CategoryCollectConfig {
  categoryId String   @id
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  config     Json
  updatedAt  DateTime @updatedAt
}

/// 候选资源：Agent 整理后的待审条目，永不自动上架。
/// normalizedUrl 为主链接规范化结果（唯一）；urlKeys 含官网与 GitHub 的全部规范化键，用于去重（含已拒绝）。
model ResourceCandidate {
  id              String          @id @default(cuid())
  normalizedUrl   String          @unique
  urlKeys         String[]
  status          CandidateStatus @default(pending)
  name            String
  source          String          @db.VarChar(24)
  sourceUrl       String
  stars           Int?
  sourceUpdatedAt DateTime?
  rawSummary      String          @default("")
  /// 模型整理结果（name/slug/summary/description/categorySlug/tags/websiteUrl/githubUrl/pricingType/toolSlugs）
  payload         Json
  reason          String          @default("")
  confidence      Float           @default(0)
  linkStatus      Int?
  runId           String?
  run             CollectRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  resourceId      String?
  resource        Resource?       @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, createdAt])
}
