# PostgreSQL 连接串（Neon / Supabase 等托管库）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/crayon_cat?schema=public"

# Auth.js：openssl rand -base64 32
AUTH_SECRET=""

# 站点地址（用于 canonical / sitemap）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 种子脚本创建首个管理员（仅本地/首次部署使用）
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# 采集 Agent：模型 API Key / Token 的加密密钥（openssl rand -base64 32）。
# 不设置时用 AUTH_SECRET 派生；那样更换 AUTH_SECRET 会让后台已保存的密钥失效。
AGENT_ENCRYPTION_KEY=""

# 每日定时采集（vercel.json crons → /api/cron/collect）的鉴权密钥；不设置则定时接口一律拒绝。
CRON_SECRET=""
